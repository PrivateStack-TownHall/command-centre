# Copy to .env and fill in.

PORT=3000

# --- Database (stores snapshots) -------------------------------------------
# PostgreSQL connection string. On Render use the database's Internal URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/command_centre_bff
# true for managed databases that require TLS (e.g. Render external URL).
DATABASE_SSL=false

# --- CORS --------------------------------------------------------------------
# Comma-separated origins of the Command Centre front-end.
FRONTEND_ORIGIN=http://localhost:5000

# --- Snapshots -----------------------------------------------------------------
# A snapshot older than this is served as-is and refreshed in the background.
SNAPSHOT_TTL_SECONDS=300
# A refresh that started longer ago than this is considered dead and may restart.
REFRESH_LOCK_SECONDS=300
# POST /snapshots/refresh is ignored for apps refreshed more recently than this.
MANUAL_REFRESH_MIN_SECONDS=30
# How many "latest" reviews/orders are kept per application.
LATEST_ITEMS_LIMIT=5

# --- Health history ------------------------------------------------------------
# How long health checks are kept for uptime and latency history.
HEALTH_HISTORY_RETENTION_DAYS=7
# Window used for the uptime percentage on /monitoring.
UPTIME_WINDOW_HOURS=24

# --- Applications ------------------------------------------------------------------
# Base URL of each backend. Leave empty if it isn't deployed yet.
KINGS_BREW_URL=https://kings-brew.onrender.com
CASTLE_KITCHEN_URL=https://castle-kitchen.onrender.com
TRADE_HUB_URL=https://trade-hub-zh4z.onrender.com
BYTE_BURGER_URL=https://byte-burger.onrender.com
QUANTUM_MART_URL=https://quantum-mart.onrender.com

PINEAPPLE_STACK_URL=https://pineapple-stack.onrender.com
M_PLOYEE_URL=https://m-ployee.onrender.com
CODIGRAM_URL=https://codigram.onrender.com
LEATHER_SHELF_URL=https://leather-shelf.onrender.com
WARETRACK_URL=https://waretrack-os08.onrender.com

MEDIEVAL_AIRBNB_URL=
NOMAD_URL=
