# Copy this file to .env and fill in the base URL for each application.
# Leave a value empty ("") if that application's backend isn't deployed yet —
# its pages then show an empty state instead of erroring.

VITE_APP_NAME=Command Centre

# --- Command Centre BFF ---------------------------------------------------
# Dashboard and Monitoring read from the BFF, which serves cached snapshots
# of every backend. Run it with `npm run start:dev` in the BFF repository.
VITE_BFF_URL=http://localhost:3000

# --- commerce-core (deployed) -------------------------------------------
VITE_KINGS_BREW_URL=https://kings-brew.onrender.com
VITE_CASTLE_KITCHEN_URL=https://castle-kitchen.onrender.com
VITE_TRADE_HUB_URL=https://trade-hub-zh4z.onrender.com
VITE_BYTE_BURGER_URL=https://byte-burger.onrender.com
VITE_QUANTUM_MART_URL=https://quantum-mart.onrender.com

# --- operations-core (deployed) -----------------------------------------
VITE_PINEAPPLE_STACK_URL=https://pineapple-stack.onrender.com
VITE_M_PLOYEE_URL=https://m-ployee.onrender.com
VITE_CODIGRAM_URL=https://codigram.onrender.com
VITE_LEATHER_SHELF_URL=https://leather-shelf.onrender.com
VITE_WARETRACK_URL=https://waretrack-os08.onrender.com

# --- TEMPLATE applications — no backend exists yet ------------------------
# Fill these in (and adjust src/features/applications/config/application.config.ts,
# see the "TEMPLATE" comments there) once each API is finalized.
VITE_MEDIEVAL_AIRBNB_URL=
VITE_NOMAD_URL=

# --- Optional services ---------------------------------------------------
# (Audit logs now come from the BFF's activities section — no URL needed.)
